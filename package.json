{
  "name": "strava-dashboard",
  "version": "1.0.0",
  "description": "A mobile-friendly dashboard that connects to Strava, fetches user data, and displays it with a gamified ranking system.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/assets/tailwind.css --minify",
    "test": "node --test"
  },
  "keywords": [
    "Strava",
    "Dashboard",
    "OAuth",
    "Express",
    "Node.js"
  ],
  "author": "Michele Merelli",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "googleapis": "^105.0.0",
    "i18n-iso-countries": "^7.14.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "nodemon": "^2.0.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13"
  }
}
